# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/task_planner
DATABASE_ECHO=false

# API Configuration
API_TITLE=Task Planning Service
API_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000

# Scheduler Configuration
SOLVER_TIME_LIMIT=60
DEFAULT_SOLVER=ortools
MAX_PLANNING_HORIZON_DAYS=90
DEFAULT_WORKING_HOURS_PER_DAY=8

# Logging
LOG_LEVEL=INFO
DEBUG=False

# Report Settings
REPORT_TEMPLATE_DIR=templates/reports
REPORT_OUTPUT_DIR=output/reports
